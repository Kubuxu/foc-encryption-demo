{
  "name": "foc-encryption",
  "version": "0.1.0",
  "description": "COSE-based encryption envelopes for content-addressed data in the Filecoin on-chain cloud ecosystem",
  "type": "module",
  "license": "(Apache-2.0 OR MIT)",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.7.0",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "wireit",
    "test": "wireit",
    "lint": "wireit",
    "typecheck": "tsc --noEmit"
  },
  "wireit": {
    "build": {
      "command": "tsc --pretty",
      "clean": "if-file-deleted",
      "files": ["src/**/*.ts", "tsconfig.json"],
      "output": ["dist/**"]
    },
    "test": {
      "command": "vitest run --passWithNoTests",
      "files": ["src/**/*.ts", "tests/**/*.ts"],
      "output": [],
      "dependencies": ["lint"]
    },
    "lint": {
      "command": "biome check .",
      "files": ["src/**/*.ts", "tests/**/*.ts", "biome.json"],
      "output": [],
      "dependencies": ["build"]
    }
  },
  "dependencies": {
    "cborg": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "typescript": "^5.9.0-beta",
    "vitest": "^3.1.0",
    "wireit": "^0.14.0"
  }
}
