{
  "name": "foc-demo",
  "version": "0.1.0",
  "description": "CLI demo for foc-encryption — encrypt/decrypt files with FOC warm storage",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "wireit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "wireit": {
    "build": {
      "command": "tsc --pretty",
      "clean": "if-file-deleted",
      "files": [
        "src/**/*.ts",
        "tsconfig.json"
      ],
      "output": [
        "dist/**"
      ],
      "dependencies": [
        "../foc-encryption:build"
      ]
    }
  },
  "bin": {
    "foc-demo": "./dist/cli.js"
  },
  "dependencies": {
    "@filoz/synapse-sdk": "^0.40.0",
    "cleye": "^1.3.2",
    "foc-encryption": "workspace:*",
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0",
    "wireit": "^0.14.0"
  }
}
